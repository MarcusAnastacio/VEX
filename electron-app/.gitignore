# Electron packaging output
dist/
out/
release/

# Screenshots written by COMPAT_SCREENSHOT=<path>. The default is /tmp, but if a
# path inside the repo is used, keep it out of git.
screenshots/

# ── Intentionally NOT ignored ───────────────────────────────────────────────
# backend/fixtures/          vendored sample stores (upstream data, needed by
#                            `npm run scan:fixtures`)
# backend/registry.json      vendored agent registry
# backend/test/fixtures/     generated by `npm test`, but kept in git on purpose:
#                            it is the readable reference for the VS Code chat
#                            operation-log format, and it is tiny (~5 KB).
# package-lock.json          pins the Electron version, which must stay >= 44
#                            for node:sqlite and zstd support
.pi/
